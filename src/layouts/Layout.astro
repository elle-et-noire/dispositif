---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/nunito";
import "@styles/globals.css";
import "@styles/reading-mode.css";
import { withBase } from "@lib/base";
import Toc from "@components/Toc.astro";
import ArticleIndex from "@components/ArticleIndex.astro";
import type { Heading } from "@lib/toc";

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  article?: boolean;
}

const {
  title = "記事一覧",
  description = "Description of something with working codes",
  headings = [],
  article = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja" class="antialiased" data-page-kind={article ? "article" : "index"} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
      // With JavaScript enabled, keep the article out of the first paint until
      // the reader has selected its initial mode and restored its position.
      // This script runs once per full load; client-side navigations mark the
      // destination before Astro swaps it in, since inline head scripts do not
      // run while Astro parses that document.
      const markPending = (root) => {
        if (root.dataset.pageKind === "article") root.classList.add("rm-pending");
      };
      markPending(document.documentElement);
      // rm-pending hides the article with clip-path, which leaves it in the
      // accessibility tree; aria-hidden keeps it out for the same span. The
      // reader removes both in its first frame (reading-mode.ts), as does the
      // fallback below. Without JavaScript neither is set.
      const hideArticle = (doc) => {
        const scrollport = doc.querySelector(".rm-article-scrollport");
        scrollport?.setAttribute("aria-hidden", "true");
        return Boolean(scrollport);
      };
      // The hidden article stays focusable: Tab would reach the scrollport and
      // the links and buttons inside it while they are aria-hidden and clipped.
      // inert would prevent that, but it is inherited through style like
      // visibility, so toggling it restyles the whole article (~35-40 ms in
      // both engines). Instead, ignore Tab for the pending span, usually one
      // frame to a few hundred ms. Focus moved by script (the reader focuses a
      // hash target before it clears rm-pending) is left alone.
      document.addEventListener("keydown", (event) => {
        if (event.key === "Tab" && document.documentElement.classList.contains("rm-pending")) event.preventDefault();
      }, { capture: true });
      // With n段 stored, put the article text in the reader's first column
      // before the swap, at the column width. Its first layout, during which
      // the math fonts are found, is then the one the reader measures, instead
      // of a single-column layout that the reader would repeat at the column
      // width. The new document is not rendered yet, so moving it is free.
      // On a full page load, the observer below does the same while the article
      // is being parsed.
      // ?view=multi or ?view=single in the destination URL wins over the
      // stored mode (opensMulti() in reading-preference.ts). After a reader
      // toggles such a page, reloading it keeps the toggled mode, which this
      // guess ignores; the reader then undoes the premount (releasePremounted).
      const wantsColumn = (doc, url) => {
        const view = new URLSearchParams(url.search).get("view");
        let multi = view === "multi";
        if (view !== "multi" && view !== "single") {
          try { multi = localStorage.getItem("dispositif:reading-mode") === "multi"; } catch { /* storage is optional */ }
        }
        return multi && doc.documentElement.dataset.pageKind === "article" && !matchMedia("print").matches;
      };
      const premountColumn = (doc, url) => {
        if (!wantsColumn(doc, url)) return;
        const source = doc.querySelector(".rm-source");
        const reader = doc.querySelector(".rm-reader");
        const plane = reader?.querySelector(".rm-plane");
        if (!source || !plane || plane.firstChild || reader.nextElementSibling !== source) return;
        // The same structure as the reader's mountSlot().
        const part = (name) => {
          const element = doc.createElement("div");
          element.className = name;
          return element;
        };
        const track = part("rm-track"), slot = part("rm-slot"), shade = part("rm-shade"), paper = part("rm-paper");
        shade.setAttribute("aria-hidden", "true");
        paper.setAttribute("aria-hidden", "true");
        source.classList.add("rm-content");
        // The reader replaces this with the same width in px.
        source.style.width = "var(--rm-column-width)";
        slot.append(source, shade, paper);
        track.append(slot);
        plane.append(track);
        reader.hidden = false;
        // The article's n段 layout too (not the header's, which is visible):
        // Firefox rebuilds the text's boxes when its ancestors change position.
        doc.documentElement.classList.add("rm-premount");
      };
      // On a full page load, the head script runs before the body is parsed.
      // Mark the scrollport aria-hidden as soon as the parser attaches it, and
      // in n段 move .rm-source as soon as it is attached (right after
      // .rm-reader, ReadingMode.astro). The parser keeps appending the rest of
      // the text to the moved element, so the frames rendered during the parse
      // lay it out in its column. Mutation callbacks run at the microtask
      // checkpoint after the parser task that inserted the element, before the
      // next rendering opportunity. Both elements come before the article
      // text, so the observer stops early. (An inline script in the body
      // would block the parser and cost Firefox a style pass.)
      if (document.documentElement.classList.contains("rm-pending")) {
        let hidden = false;
        let column = wantsColumn(document, location);
        const observer = new MutationObserver(() => {
          if (!hidden) hidden = hideArticle(document);
          if (column && document.querySelector(".rm-source")) {
            column = false;
            premountColumn(document, location);
          }
          if (hidden && !column) observer.disconnect();
        });
        observer.observe(document, { childList: true, subtree: true });
        document.addEventListener("DOMContentLoaded", () => observer.disconnect(), { once: true });
      }
      // Undo premountColumn() for the single-column fallback below.
      const unmountColumn = () => {
        const source = document.querySelector(".rm-plane .rm-source");
        const reader = document.querySelector(".rm-reader");
        document.documentElement.classList.remove("rm-premount");
        if (!source || !reader) return;
        reader.after(source);
        source.classList.remove("rm-content");
        source.style.removeProperty("width");
        reader.querySelector(".rm-plane").replaceChildren();
        reader.hidden = true;
      };
      document.addEventListener("astro:before-swap", (event) => {
        markPending(event.newDocument.documentElement);
        if (event.newDocument.documentElement.classList.contains("rm-pending")) hideArticle(event.newDocument);
        // The address bar still shows the old page here.
        premountColumn(event.newDocument, event.to);
      });
      // If the reader bundle fails or stalls, leave a usable single-column
      // article instead of keeping the content hidden indefinitely.
      // Only one navigation can be pending, so a newer arm replaces the timer
      // left by an earlier one. Once the reader has started (rm-ready), it
      // owns clearing rm-pending: its first frame may be delayed for longer
      // than this timeout in a background tab, which is not a failure.
      let fallbackTimer;
      const armReaderFallback = () => {
        clearTimeout(fallbackTimer);
        const root = document.documentElement;
        if (!root.classList.contains("rm-pending")) return;
        fallbackTimer = setTimeout(() => {
          if (root !== document.documentElement || !root.classList.contains("rm-pending")
            || root.classList.contains("rm-ready")) return;
          unmountColumn();
          root.classList.add("rm-fallback");
          root.classList.remove("rm-pending");
          document.querySelector(".rm-article-scrollport")?.removeAttribute("aria-hidden");
          // The table of contents skipped its position while pre-mounted (Toc.astro).
          document.dispatchEvent(new CustomEvent("rm:off"));
        }, 10000);
      };
      armReaderFallback();
      document.addEventListener("astro:after-swap", armReaderFallback);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("favicon.ico")} />
    <!-- The same page with ?view= (reading mode) is not another page. -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <main class="min-h-svh bg-[#a0bac8] pb-12">
      <header data-site-header class:list={["fixed inset-x-0 top-0 z-0 w-full bg-[#f8f8f8] pb-2 pt-4 text-center font-system text-lg text-[#112b45] underline decoration-yellow-300 decoration-4 underline-offset-[12px] shadow-[0_1px_1px_1px_rgba(0,0,0,0.3)] md:text-2xl", { "site-header--toc": headings.length > 0 }]}>
        <a href={withBase()} class="site-article-index text-inherit decoration-inherit">記事一覧</a>
        <Toc headings={headings} />
      </header>
      <div class="article-index-shell" inert={article} aria-hidden={article ? "true" : undefined} tabindex={article ? undefined : 0} role={article ? undefined : "region"} aria-label={article ? undefined : "記事一覧"}>
        <ArticleIndex />
      </div>
      <slot />
    </main>
  </body>
</html>
