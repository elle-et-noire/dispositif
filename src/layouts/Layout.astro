---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/nunito";
import "@styles/globals.css";
import "@styles/reading-mode.css";
import { withBase } from "@lib/base";
import Toc from "@components/Toc.astro";
import ArticleIndex from "@components/ArticleIndex.astro";
import type { Heading } from "@lib/toc";

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  article?: boolean;
}

const {
  title = "記事一覧",
  description = "Description of something with working codes",
  headings = [],
  article = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja" class="antialiased" data-page-kind={article ? "article" : "index"} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
      // With JavaScript enabled, keep the article out of the first paint until
      // the reader has selected its initial mode and restored its position.
      // This script runs once per full load; client-side navigations mark the
      // destination before Astro swaps it in, since inline head scripts do not
      // run while Astro parses that document.
      const markPending = (root) => {
        if (root.dataset.pageKind === "article") root.classList.add("rm-pending");
      };
      markPending(document.documentElement);
      document.addEventListener("astro:before-swap", (event) => markPending(event.newDocument.documentElement));
      // If the reader bundle fails or stalls, leave a usable single-column
      // article instead of keeping the content hidden indefinitely.
      // Only one navigation can be pending, so a newer arm replaces the timer
      // left by an earlier one. Once the reader has started (rm-ready), it
      // owns clearing rm-pending: its first frame may be delayed for longer
      // than this timeout in a background tab, which is not a failure.
      let fallbackTimer;
      const armReaderFallback = () => {
        clearTimeout(fallbackTimer);
        const root = document.documentElement;
        if (!root.classList.contains("rm-pending")) return;
        fallbackTimer = setTimeout(() => {
          if (root !== document.documentElement || !root.classList.contains("rm-pending")
            || root.classList.contains("rm-ready")) return;
          root.classList.add("rm-fallback");
          root.classList.remove("rm-pending");
        }, 10000);
      };
      armReaderFallback();
      document.addEventListener("astro:after-swap", armReaderFallback);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("favicon.ico")} />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <main class="min-h-svh bg-[#a0bac8] pb-12">
      <header data-site-header class:list={["fixed inset-x-0 top-0 z-0 w-full bg-[#f8f8f8] pb-2 pt-4 text-center font-system text-lg text-[#112b45] underline decoration-yellow-300 decoration-4 underline-offset-[12px] shadow-[0_1px_1px_1px_rgba(0,0,0,0.3)] md:text-2xl", { "site-header--toc": headings.length > 0 }]}>
        <a href={withBase()} class="site-article-index text-inherit decoration-inherit">記事一覧</a>
        <Toc headings={headings} />
      </header>
      <div class="article-index-shell" inert={article} aria-hidden={article ? "true" : undefined} tabindex={article ? undefined : 0} role={article ? undefined : "region"} aria-label={article ? undefined : "記事一覧"}>
        <ArticleIndex />
      </div>
      <slot />
    </main>
  </body>
</html>
