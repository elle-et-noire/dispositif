---
import Layout from "@layouts/Layout.astro";
import DateInfo from "@components/DateInfo.astro";
import ArticleInteractions from "@components/ArticleInteractions.astro";
import ReadingMode from "@components/ReadingMode.astro";
import Toc from "@components/Toc.astro";
import { markdownToHtml } from "@lib/convert";
import { MATH_FONT_PRELOAD_HREF } from "@lib/mathjax";
import { getAllSlugs, getPostBySlug } from "@lib/post";
import { getHeadings } from "@lib/toc";
import { withBase } from "@lib/base";

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({
    params: { slug },
    props: getPostBySlug(slug),
  }));
}

const { content, data } = Astro.props;
const { html, css } = await markdownToHtml(content);
const headings = getHeadings(content);
---

<Layout title={data.title} headings={headings} article>
  {
    css && (
      <Fragment slot="head">
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={MATH_FONT_PRELOAD_HREF}
          crossorigin="anonymous"
        />
        <style is:inline set:html={css} />
      </Fragment>
    )
  }

  <a
    href={withBase()}
    data-astro-prefetch="hover"
    aria-label="記事を閉じて一覧へ戻る"
    class="rm-backdrop fixed inset-0 z-10 block cursor-pointer bg-[#76ddfc]/15 backdrop-blur-[3px]"
  ></a>

  <article class="rm-article prose relative z-20 mx-auto mt-8 flex w-[calc(100%-1rem)] max-w-[68rem] flex-col px-4 pb-16 md:pl-16 md:pr-4">
    <div class="rm-toolbar not-prose">
      <button class="rm-toggle" type="button" aria-pressed="false" aria-label="n段の読書モード">1段 / n段</button>
      <Toc headings={headings} variant="mobile" />
      <details class="rm-settings">
        <summary class="rm-settings-toggle">表示設定</summary>
        <div class="rm-settings-panel">
          <label class="rm-overlap-control not-prose" for="rm-overlap">
            <span>重なり</span>
            <input
              id="rm-overlap"
              class="rm-overlap-input"
              data-rm-overlap
              type="number"
              inputmode="numeric"
              min="0"
              step="1"
              value="0"
              aria-label="段間の本文の重なり（px）"
            />
            <span aria-hidden="true">px</span>
          </label>
          <div class="rm-jump-controls">
            <button type="button" data-rm-edge="start">先頭へ</button>
            <button type="button" data-rm-edge="end">末尾へ</button>
          </div>
        </div>
      </details>
      <a
        href={withBase()}
        data-astro-prefetch="hover"
        aria-label="記事を閉じて一覧へ戻る"
        class="rm-close"
      >
        <span class="batsu" aria-hidden="true"></span>
      </a>
    </div>

    <div class="rm-layout grid min-w-0 grid-cols-1 md:grid-cols-[minmax(0,48rem)_13rem]">
      <div class="rm-source min-w-0 w-full font-noto-sans">
        <h1 class="mb-1 text-lg font-semibold text-[#101828] sm:text-3xl md:mb-3 md:text-4xl">
          {data.title}
        </h1>
        <DateInfo data={data} class="text-xs sm:text-base" />
        <div class="post" set:html={html} />
      </div>
      <ReadingMode />
      <aside class="rm-toc hidden min-w-0 w-full pl-4 md:block">
        <Toc headings={headings} variant="sidebar" />
      </aside>
    </div>
  </article>

  <ArticleInteractions />
</Layout>
