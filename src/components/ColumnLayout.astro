---
// The article text (.cl-source) goes in the slot, directly after the reader's
// markup: with n段 stored, Layout.astro moves it into the reader's first
// column as soon as the parser attaches it.
---
<div class="cl-reader" hidden>
  <div
    class="cl-viewport"
    tabindex="0"
    role="region"
    aria-label="n段の読書領域。上下にスクロールできます。左右キーで段移動、PageDown・Spaceで先へ、PageUp・Shift+Spaceで前へ、Home・Endで先頭・末尾へ"
  >
    <div class="cl-plane"></div>
  </div>
</div>
<slot />
<div class="cl-ruler" aria-hidden="true"><div></div></div>

<script>
  import { initializeColumnLayout } from "../scripts/column-layout";
  document.addEventListener("astro:page-load", initializeColumnLayout);
</script>
