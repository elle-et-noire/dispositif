---
import Layout from "@layouts/Layout.astro";
import DateInfo from "@components/DateInfo.astro";
import Toc from "@components/Toc.astro";
import ArticleInteractions from "@components/ArticleInteractions.astro";
import { markdownToHtml } from "@lib/convert";
import { MATH_FONT_PRELOAD_HREF } from "@lib/mathjax";
import { getAllSlugs, getPostBySlug } from "@lib/post";
import { getHeadings } from "@lib/toc";
import { withBase } from "@lib/base";

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({
    params: { slug },
    props: getPostBySlug(slug),
  }));
}

const { content, data } = Astro.props;
const { html, css } = await markdownToHtml(content);
const headings = getHeadings(content);
---

<Layout title={data.title}>
  {
    css && (
      <Fragment slot="head">
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href={MATH_FONT_PRELOAD_HREF}
          crossorigin="anonymous"
        />
        <style is:inline set:html={css} />
      </Fragment>
    )
  }

  <a
    href={withBase()}
    data-astro-prefetch="hover"
    aria-label="記事を閉じて一覧へ戻る"
    class="fixed inset-0 z-10 block cursor-pointer bg-[#76ddfc]/15 backdrop-blur-[3px]"
  ></a>

  <article class="prose relative z-20 mx-auto mt-8 flex w-[22rem] max-w-none flex-col rounded-lg bg-[#f8f8f8] px-4 pb-16 shadow-[0_0_3px_0_rgba(128,128,128,0.5)] sm:w-[40rem] md:w-[68rem] md:pl-16 md:pr-4">
    <div class="invisible sticky top-0 z-30 flex justify-end pt-4">
      <a
        href={withBase()}
        data-astro-prefetch="hover"
        aria-label="記事を閉じて一覧へ戻る"
        class="visible h-8"
      >
        <span class="batsu" aria-hidden="true"></span>
      </a>
    </div>

    <div class="grid grid-flow-col justify-stretch">
      <div class="w-[20rem] overflow-x-visible font-noto-sans sm:w-[38rem] md:w-[48rem]">
        <h1 class="mb-1 text-lg font-semibold text-[#101828] sm:text-3xl md:mb-3 md:text-4xl">
          {data.title}
        </h1>
        <DateInfo data={data} class="text-xs sm:text-base" />
        <div class="post" set:html={html} />
      </div>
      <aside class="hidden w-full pl-4 md:block md:w-[12rem]">
        <Toc headings={headings} />
      </aside>
    </div>
  </article>

  <ArticleInteractions />
</Layout>
