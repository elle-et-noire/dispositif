---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/nunito";
import "@styles/globals.css";
import "@styles/column-layout.css";
import { withBase } from "@lib/base";
import Toc from "@components/Toc.astro";
import ArticleIndex from "@components/ArticleIndex.astro";
import type { Heading } from "@lib/toc";

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  article?: boolean;
}

const {
  title = "記事一覧",
  description = "Description of something with working codes",
  headings = [],
  article = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja" class="antialiased" data-page-kind={article ? "article" : "index"} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (() => {
      // With JavaScript enabled, keep the article out of the first paint until
      // the reader has selected its initial column layout and restored its position.
      // This script runs once per full load; client-side navigations mark the
      // destination before Astro swaps it in, since inline head scripts do not
      // run while Astro parses that document.
      const markPending = (root) => {
        if (root.dataset.pageKind === "article") root.classList.add("cl-pending");
      };
      markPending(document.documentElement);
      // cl-pending hides the article with clip-path, which leaves it in the
      // accessibility tree; aria-hidden keeps it out for the same span. The
      // reader removes both in its first frame (column-layout.ts), as does the
      // fallback below. Without JavaScript neither is set.
      const hideArticle = (doc) => {
        const scrollport = doc.querySelector(".cl-article-scrollport");
        scrollport?.setAttribute("aria-hidden", "true");
        return Boolean(scrollport);
      };
      // The hidden article stays focusable: Tab would reach the scrollport and
      // the links and buttons inside it while they are aria-hidden and clipped.
      // inert would prevent that, but it is inherited through style like
      // visibility, so toggling it restyles the whole article (~35-40 ms in
      // both engines). Instead, ignore Tab for the pending span, usually one
      // frame to a few hundred ms. Focus moved by script (the reader focuses a
      // hash target before it clears cl-pending) is left alone.
      document.addEventListener("keydown", (event) => {
        if (event.key === "Tab" && document.documentElement.classList.contains("cl-pending")) event.preventDefault();
      }, { capture: true });
      // With n段 stored, make the original's column around the article text
      // (ColumnLayout.astro) the reader's first column before the swap, at the
      // column width. The text's first layout, during which the math fonts are
      // found, is then the one the reader measures, instead of a single-column
      // layout that the reader would repeat at the column width. The new
      // document is not rendered yet, so this is free.
      // On a full page load, the observer below does the same while the article
      // is being parsed.
      // ?columns=multi or ?columns=single in the destination URL wins over the
      // stored choice (opensMulti() in column-preference.ts). After a reader
      // toggles such a page, reloading it keeps the toggled column layout, which this
      // guess ignores; the reader then undoes the premount (releasePremounted).
      const wantsColumn = (doc, url) => {
        const columns = new URLSearchParams(url.search).get("columns");
        let multi = columns === "multi";
        if (columns !== "multi" && columns !== "single") {
          try { multi = localStorage.getItem("dispositif:columns") === "multi"; } catch { /* storage is optional */ }
        }
        return multi && doc.documentElement.dataset.pageKind === "article" && !matchMedia("print").matches;
      };
      const premountColumn = (doc, url) => {
        if (!wantsColumn(doc, url)) return;
        const source = doc.querySelector(".cl-original > .cl-original-slot > .cl-source");
        if (!source) return;
        // The same classes as the reader's mountOriginal().
        source.parentElement.classList.add("cl-slot");
        source.parentElement.parentElement.classList.add("cl-track");
        source.classList.add("cl-content");
        // The reader replaces this with the same width in px.
        source.style.width = "var(--cl-column-width)";
        // The article's n段 layout too (not the header's, which is visible):
        // Firefox rebuilds the text's boxes when its ancestors change position.
        doc.documentElement.classList.add("cl-premount");
      };
      // Leave all but the first blocks of the article text out of its first
      // layout (column-layout.css), which is then a fraction of the whole
      // article; the reader shows the rest once its first frame is painted
      // (column-layout.ts). Not for a fragment or a history entry: the
      // position can then be anywhere in the text, and the reader shows it
      // all at once anyway. Without JavaScript nothing is left out.
      // The mark goes on the twelfth block; the blocks after it are left out.
      // Returns whether it was placed.
      const deferText = (doc, url, traverse) => {
        if (doc.documentElement.dataset.pageKind !== "article" || url.hash || traverse) return false;
        const block = doc.querySelector(".cl-source > .post")?.children[11];
        block?.setAttribute("data-cl-defer", "");
        return Boolean(block);
      };
      // On a full page load, the head script runs before the body is parsed.
      // Mark the scrollport aria-hidden as soon as the parser attaches it, and
      // in n段 make the column around .cl-source a column as soon as the text
      // is attached, so the frames rendered during the parse lay the text out
      // there. Mutation callbacks run at the microtask checkpoint after the
      // parser task that inserted the element, before the next rendering
      // opportunity. Both elements come before the article
      // text; the observer stops once the twelfth block of the text is marked
      // (deferText), or at DOMContentLoaded for a shorter article. (An inline
      // script in the body would block the parser and cost Firefox a style
      // pass.) A reload keeps the history entry's state, from which the reader
      // restores the position.
      if (document.documentElement.classList.contains("cl-pending")) {
        let hidden = false;
        let column = wantsColumn(document, location);
        let defer = !location.hash && typeof history.state?.dispositifReadingKey !== "string";
        const observer = new MutationObserver(() => {
          if (!hidden) hidden = hideArticle(document);
          if (defer && deferText(document, location, false)) defer = false;
          if (column && document.querySelector(".cl-source")) {
            column = false;
            premountColumn(document, location);
          }
          if (hidden && !column && !defer) observer.disconnect();
        });
        observer.observe(document, { childList: true, subtree: true });
        document.addEventListener("DOMContentLoaded", () => observer.disconnect(), { once: true });
      }
      // Undo premountColumn() for the single-column fallback below.
      const unmountColumn = () => {
        document.documentElement.classList.remove("cl-premount");
        document.querySelector(".cl-original")?.classList.remove("cl-track");
        document.querySelector(".cl-original-slot")?.classList.remove("cl-slot");
        const source = document.querySelector(".cl-source");
        source?.classList.remove("cl-content");
        source?.style.removeProperty("width");
      };
      document.addEventListener("astro:before-swap", (event) => {
        markPending(event.newDocument.documentElement);
        if (event.newDocument.documentElement.classList.contains("cl-pending")) hideArticle(event.newDocument);
        // The address bar still shows the old page here.
        premountColumn(event.newDocument, event.to);
        deferText(event.newDocument, event.to, event.navigationType === "traverse");
      });
      // If the reader bundle fails or stalls, leave a usable single-column
      // article instead of keeping the content hidden indefinitely.
      // Only one navigation can be pending, so a newer arm replaces the timer
      // left by an earlier one. Once the reader has started (cl-ready), it
      // owns clearing cl-pending: its first frame may be delayed for longer
      // than this timeout in a background tab, which is not a failure.
      let fallbackTimer;
      const armReaderFallback = () => {
        clearTimeout(fallbackTimer);
        const root = document.documentElement;
        if (!root.classList.contains("cl-pending")) return;
        fallbackTimer = setTimeout(() => {
          if (root !== document.documentElement || !root.classList.contains("cl-pending")
            || root.classList.contains("cl-ready")) return;
          unmountColumn();
          document.querySelector(".cl-source > .post > [data-cl-defer]")?.removeAttribute("data-cl-defer");
          root.classList.add("cl-fallback");
          root.classList.remove("cl-pending");
          document.querySelector(".cl-article-scrollport")?.removeAttribute("aria-hidden");
          // The table of contents skipped its position while pre-mounted (Toc.astro).
          document.dispatchEvent(new CustomEvent("cl:single"));
        }, 10000);
      };
      armReaderFallback();
      document.addEventListener("astro:after-swap", armReaderFallback);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("favicon.ico")} />
    <!-- The same page with ?columns= (the column layout) is not another page. -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <main class="min-h-svh bg-[#a0bac8] pb-12">
      <header data-site-header class:list={["fixed inset-x-0 top-0 z-0 w-full bg-[#f8f8f8] pb-2 pt-4 text-center font-system text-lg text-[#112b45] underline decoration-yellow-300 decoration-4 underline-offset-[12px] shadow-[0_1px_1px_1px_rgba(0,0,0,0.3)] md:text-2xl", { "site-header--toc": headings.length > 0 }]}>
        <a href={withBase()} class="site-article-index text-inherit decoration-inherit">記事一覧</a>
        <Toc headings={headings} />
      </header>
      <div class="article-index-shell" inert={article} aria-hidden={article ? "true" : undefined} tabindex={article ? undefined : 0} role={article ? undefined : "region"} aria-label={article ? undefined : "記事一覧"}>
        <ArticleIndex />
      </div>
      <slot />
    </main>
  </body>
</html>
