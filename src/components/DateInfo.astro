---
import type { PostFrontmatter } from "@lib/post";

interface Props {
  data: PostFrontmatter;
  class?: string;
}

const { data, class: className = "" } = Astro.props;
---

<dl class:list={["date-info", "not-prose", className]}>
  <div class="date-info-item">
    <dt>投稿日</dt>
    <dd><time datetime={data.publish}>{data.publish}</time></dd>
  </div>
  {
    data.lastUpdate && (
      <div class="date-info-item">
        <dt>最終更新日</dt>
        <dd><time datetime={data.lastUpdate}>{data.lastUpdate}</time></dd>
      </div>
    )
  }
</dl>
