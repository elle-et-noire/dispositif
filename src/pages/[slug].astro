---
import Layout from "@layouts/Layout.astro";
import DateInfo from "@components/DateInfo.astro";
import ArticleInteractions from "@components/ArticleInteractions.astro";
import ColumnLayout from "@components/ColumnLayout.astro";
import SingleColumnIcon from "../icons/single-column.svg";
import MultiColumnIcon from "../icons/multi-column.svg";
import Toc from "@components/Toc.astro";
import { markdownToHtml } from "@lib/convert";
import { mathFontFaces, separateMathFontFaces } from "@lib/math-fonts";
import { getAllSlugs, getPostBySlug } from "@lib/post";
import { getHeadings } from "@lib/toc";
import { withBase } from "@lib/base";

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({
    params: { slug },
    props: getPostBySlug(slug),
  }));
}

const { content, data } = Astro.props;
const { html, css: mathCss } = await markdownToHtml(content);
// The @font-face rules of the fonts the index prefetches on hover (the same
// list as its data-math-fonts) each get their own marked <style>, so that
// math-font-prefetch.ts can drop the ones it has already loaded before the swap.
const { css, faces: mathFaces } = separateMathFontFaces(mathCss, mathFontFaces(html, mathCss));
const headings = getHeadings(content);
---

<Layout title={data.title} headings={headings} article>
  {
    mathCss && (
      <Fragment slot="head">
        {/* Every math font the article uses, not only the large MJX-TEX-N:
            a font found during the first layout arrives after it, and each
            arrival lays the whole article out again. */}
        {mathFaces.map(({ url }) => (
          <link
            data-math-font-preload
            rel="preload"
            as="font"
            type="font/woff2"
            href={url}
            crossorigin="anonymous"
          />
        ))}
        <style is:inline set:html={css} />
        {mathFaces.map(({ family, url, rule }) => (
          <style is:inline data-math-font={family} data-math-font-url={url} set:html={rule} />
        ))}
      </Fragment>
    )
  }

  <div
    aria-hidden="true"
    class="cl-backdrop fixed inset-0 z-10 block cursor-pointer bg-[#76ddfc]/15 backdrop-blur-[3px]"
  ></div>

  <div class="cl-article-scrollport" tabindex="0" role="region" aria-label="記事本文">
    {/* Pointer-only: the background around the paper. Keyboard and screen
        reader users get the same action from .cl-close, so this link is kept
        out of the Tab order and the accessibility tree. */}
    <a
      href={withBase()}
      data-astro-prefetch="hover"
      tabindex="-1"
      aria-hidden="true"
      class="cl-dismiss block cursor-pointer"
    ></a>
    <article class="cl-article prose relative z-20 mx-auto mt-8 flex w-[calc(100%-1rem)] max-w-[68rem] flex-col px-4 pb-16 md:pl-16 md:pr-4">
      <div class="cl-layout grid min-w-0 grid-cols-1">
        <aside class="cl-sidebar">
          <div class="cl-sidebar-stack">
            <div class="cl-toolbar not-prose">
              <button class="cl-toggle" type="button" aria-pressed="false" aria-label="n段表示" title="n段表示に切り替える">
                <MultiColumnIcon class="cl-toggle-to-multi" aria-hidden="true" />
                <SingleColumnIcon class="cl-toggle-to-single" aria-hidden="true" />
              </button>
              <Toc headings={headings} variant="mobile" />
              <a
                href={withBase()}
                data-astro-prefetch="hover"
                aria-label="記事を閉じて一覧へ戻る"
                class="cl-close"
              >
                <span class="batsu" aria-hidden="true"></span>
              </a>
            </div>
            <div class="cl-toc hidden md:flex">
              <Toc headings={headings} variant="sidebar" />
            </div>
          </div>
        </aside>
        <ColumnLayout>
          <div class="cl-source min-w-0 w-full font-noto-sans">
            <h1 class="mb-1 text-lg font-semibold text-[#101828] sm:text-3xl md:mb-3 md:text-4xl">
              {data.title}
            </h1>
            <DateInfo data={data} class="text-xs sm:text-base" />
            <div class="post" set:html={html} />
          </div>
        </ColumnLayout>
      </div>
    </article>
  </div>

  <ArticleInteractions />
</Layout>
