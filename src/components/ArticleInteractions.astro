---
// 記事本文に対するクライアント側の拡張を一か所に集約する。
// 本文そのものはビルド時 HTML のままなので、クライアントランタイムは不要。
---

<script>
  const COPY_ICON =
    '<svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const CHECK_ICON =
    '<svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
  const DETAILS_CLOSE_SIDES = ["left", "right", "bottom"] as const;
  const timers = new WeakMap<Element, number>();

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const extractCode = (figure: Element): string => {
    const lines = figure.querySelectorAll("pre code [data-line]");
    if (lines.length > 0) {
      return Array.from(lines, (line) => line.textContent ?? "").join("\n");
    }
    return figure.querySelector<HTMLElement>("pre")?.innerText ?? "";
  };

  // 吹き出しの文字は、コピーした間だけ入れる。常に置いておくと、
  // 見えないのに本文として読み上げられ（Edgeの「音声で読み上げる」など）、
  // 文字が変わらないのでrole="status"がコピーの成功を伝えられない。
  const markCopied = (button: HTMLButtonElement) => {
    const tooltip = button.querySelector(".code-copy-tooltip");
    button.dataset.copied = "true";
    if (tooltip) tooltip.textContent = "Copied!";
    const previous = timers.get(button);
    if (previous) window.clearTimeout(previous);
    timers.set(
      button,
      window.setTimeout(() => {
        delete button.dataset.copied;
        if (tooltip) tooltip.textContent = "";
      }, 2000),
    );
  };

  const copyText = async (text: string): Promise<boolean> => {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.cssText = "position:fixed;opacity:0";
    document.body.appendChild(textarea);
    textarea.select();
    try {
      const execCommand = (
        document as unknown as { execCommand(commandId: string): boolean }
      ).execCommand.bind(document);
      return execCommand("copy");
    } catch {
      return false;
    } finally {
      textarea.remove();
    }
  };

  // はみ出したディスプレイ数式の包み（lib/convert.ts の span.scrollable）だけを、名前を
  // 持つTabの停止位置にする。ChromiumとFirefoxは、はみ出したスクロール要素に
  // tabindexがなくてもTabで止まるが、名前もロールもないので、スクリーンリーダーでは
  // 何も読まれない位置になる。Safariはスクロール要素にTabで止まらないので、
  // キーボードで数式を横へ送れない。はみ出さない数式でTabが止まらないよう、幅が
  // 変わるたびに付け外しする。数式の字形の箱（mjx-math）も見るのは、数式フォントが
  // 届いて、包みの幅は変わらずに数式の幅だけが変わることがあるため。
  // n段の複製の段は、column-fragments.ts が支援技術とTabの対象から外すので見ない。
  let mathScrollObserver: ResizeObserver | undefined;
  const observeMathScrollers = () => {
    mathScrollObserver?.disconnect();
    mathScrollObserver = new ResizeObserver((entries) => {
      const scrollers = new Set<HTMLElement>();
      for (const { target } of entries) {
        const scroller = target.closest<HTMLElement>(".scrollable");
        if (scroller) scrollers.add(scroller);
      }
      // 幅をすべて読んでから属性を書き、読むたびにレイアウトし直さないようにする。
      const overflows = Array.from(scrollers, (scroller) =>
        [scroller, scroller.scrollWidth > scroller.clientWidth] as const);
      for (const [scroller, overflowing] of overflows) {
        if (overflowing === scroller.hasAttribute("tabindex")) continue;
        if (overflowing) {
          scroller.tabIndex = 0;
          scroller.setAttribute("role", "group");
          scroller.setAttribute("aria-label", "数式の横スクロール");
        } else {
          scroller.removeAttribute("tabindex");
          scroller.removeAttribute("role");
          scroller.removeAttribute("aria-label");
        }
      }
    });
    document.querySelectorAll<HTMLElement>(".post .scrollable").forEach((scroller) => {
      if (scroller.closest(".cl-copies")) return;
      mathScrollObserver!.observe(scroller);
      const math = scroller.querySelector("mjx-math");
      if (math) mathScrollObserver!.observe(math);
    });
  };

  const enhanceArticle = () => {
    observeMathScrollers();
    document.querySelectorAll<HTMLDetailsElement>(".post details").forEach((details) => {
      if (details.querySelector(":scope > .details-close-button")) return;

      DETAILS_CLOSE_SIDES.forEach((side) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `details-close-button details-close-button--${side}`;
        button.dataset.detailsClose = "";
        button.setAttribute("aria-label", "詳細を閉じる");
        button.title = "詳細を閉じる";
        if (side !== "bottom") button.tabIndex = -1;
        details.appendChild(button);
      });
    });

    document
      .querySelectorAll(".post figure[data-rehype-pretty-code-figure]")
      .forEach((figure) => {
        if (figure.querySelector(".code-copy-button")) return;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "code-copy-button";
        button.setAttribute("aria-label", "コードをコピー");
        button.innerHTML = `${COPY_ICON}${CHECK_ICON}<span class="code-copy-tooltip" role="status"></span>`;
        figure.appendChild(button);
      });

    // ClientRouter の遷移では本文リンクが新しい DOM に差し替わるため、数式参照の
    // クリック処理は astro:page-load ごとに現在のリンクへ登録する。
    document
      .querySelectorAll<HTMLAnchorElement>('.post a[href^="#mjx-eqn"]')
      .forEach((link) => {
        if (link.dataset.mathrefBound) return;
        link.dataset.mathrefBound = "true";
        link.addEventListener("click", (event) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) return;

          const id = decodeURIComponent(link.hash.slice(1));
          const equation = document.getElementById(id);
          if (!equation) return;

          event.preventDefault();
          equation.scrollIntoView({
            behavior: prefersReducedMotion() ? "auto" : "smooth",
            block: "start",
          });
          history.replaceState(history.state, "", link.hash);
          if (event.detail > 0) link.blur();
        });
      });
  };

  // 本文の吹き出し（lib/preprocess.tsの.has-tooltipの.tooltip）は、CSSが出す間
  // （語が:hoverか:focus-withinの間、globals.css）、最上位の層（popover）に移す。
  // 段組みの読書領域は1段でもn段でも本文の外を切り取る（column-layout.css）ので、
  // 本文の中に描くと、本文の左端に近い語の吹き出しが切り取られる。位置は、本文の
  // 中に描くときと同じく、語の右端と上端から決める。
  // ChromiumとWebKitは、最上位の層の吹き出しに乗っている間、語を:hoverにしない。
  // そのため、吹き出しの:hoverも見る。
  let shownTooltip: HTMLElement | undefined;
  const hideTooltip = () => {
    if (!shownTooltip) return;
    shownTooltip.hidePopover();
    shownTooltip.removeAttribute("popover");
    shownTooltip.style.removeProperty("right");
    shownTooltip.style.removeProperty("bottom");
    shownTooltip = undefined;
  };
  const showTooltip = (anchor: Element, tooltip: HTMLElement) => {
    if (tooltip !== shownTooltip) hideTooltip();
    // 語が行をまたぐときは、最初の行の上端と最後の行の右端。
    const lines = anchor.getClientRects();
    if (!lines.length) return;
    const { clientWidth, clientHeight } = document.documentElement;
    tooltip.style.right = `${clientWidth - lines[lines.length - 1].right}px`;
    tooltip.style.bottom = `${clientHeight - lines[0].top}px`;
    if (tooltip === shownTooltip) return;
    tooltip.popover = "manual";
    tooltip.showPopover();
    shownTooltip = tooltip;
  };
  // 次のフレームで調べる語。:hoverは、イベントを送った後に変わることがある。
  // Playwrightのタッチの操作では、Chromiumはタップした語の:hoverを、イベントを
  // 送らずに数フレーム後に戻した。:hoverが変わると吹き出しの不透明度が遷移するので、
  // その開始（transitionrun）でも調べる。
  const tooltipAnchors = new Set<Element>();
  let tooltipFrame = 0;
  const syncTooltip = () => {
    tooltipFrame = 0;
    if (shownTooltip?.parentElement) tooltipAnchors.add(shownTooltip.parentElement);
    let shown = false;
    for (const anchor of tooltipAnchors) {
      const tooltip = anchor.querySelector<HTMLElement>(":scope > .tooltip");
      if (shown || !tooltip || !anchor.isConnected) continue;
      if (!anchor.matches(":hover, :focus-within") && !tooltip.matches(":hover")) continue;
      showTooltip(anchor, tooltip);
      shown = true;
    }
    if (!shown) hideTooltip();
    tooltipAnchors.clear();
  };
  const queueTooltip = (...targets: (EventTarget | null)[]) => {
    for (const target of targets) {
      const anchor = target instanceof Element ? target.closest(".post .has-tooltip") : null;
      if (anchor) tooltipAnchors.add(anchor);
    }
    if (!tooltipAnchors.size && !shownTooltip) return;
    tooltipFrame ||= requestAnimationFrame(syncTooltip);
  };
  for (const type of ["mouseover", "mouseout", "focusin", "focusout", "click", "transitionrun"] as const) {
    document.addEventListener(type, (event) =>
      queueTooltip(event.target, "relatedTarget" in event ? event.relatedTarget : null));
  }
  // 語がスクロールで動いたら、吹き出しを置き直すか閉じる。
  document.addEventListener("scroll", () => queueTooltip(), { capture: true, passive: true });

  document.addEventListener("astro:page-load", enhanceArticle);

  document.addEventListener("click", async (event) => {
    const target = event.target as Element | null;
    const detailsCloseButton =
      target?.closest<HTMLButtonElement>("[data-details-close]");
    if (detailsCloseButton) {
      const details = detailsCloseButton.closest<HTMLDetailsElement>("details");
      const summary = details?.querySelector<HTMLElement>(":scope > summary");
      if (!details || !summary) return;

      const summaryRect = summary.getBoundingClientRect();
      const summaryIsVisible =
        summaryRect.bottom > 0 && summaryRect.top < window.innerHeight;

      details.open = false;
      summary.focus({ preventScroll: true });
      if (!summaryIsVisible) {
        summary.scrollIntoView({
          behavior: "instant",
          block: "start",
        });
      }
      return;
    }

    const copyButton = target?.closest<HTMLButtonElement>(".code-copy-button");
    if (copyButton) {
      const figure = copyButton.closest("figure");
      if (!figure) return;
      if (event.detail !== 0) copyButton.blur();
      if (await copyText(extractCode(figure))) markCopied(copyButton);
      return;
    }
  });

  document.addEventListener("pointerup", (event) => {
    const pre = (event.target as Element | null)?.closest<HTMLElement>(".post pre");
    if (pre && document.activeElement === pre) pre.blur();
  });
</script>
