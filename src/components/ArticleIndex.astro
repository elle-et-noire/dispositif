---
import PostCard from "./PostCard.astro";
import { getAllPosts } from "@lib/post";
import { articleMathFonts } from "@lib/convert";

const posts = getAllPosts();
const mathFonts = await Promise.all(posts.map((post) => articleMathFonts(post.content)));
---

<div
  data-article-index
  transition:persist="article-index"
  class="mx-auto flex w-full flex-col items-center gap-3 px-2 pb-16 pt-20 md:w-[48rem]"
>
  {posts.map((post, i) => <PostCard slug={post.slug} data={post.data} mathFonts={mathFonts[i]} />)}
</div>

<script>
  import "../scripts/article-background";
  import "../scripts/math-font-prefetch";
</script>
