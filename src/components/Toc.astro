---
import type { Heading } from "@lib/toc";
import TocList from "./TocList.astro";

interface Props {
  headings: Heading[];
  variant?: "header" | "sidebar" | "mobile";
}

const { headings, variant = "header" } = Astro.props;
---

{
  headings.length > 0 && (variant === "sidebar" ? (
    <nav aria-label="目次" data-toc data-toc-variant="sidebar" class="toc-sidebar not-prose">
      <h2 class="toc-sidebar-title">目次</h2>
      <div class="toc toc-scrollable toc-sidebar-scroll" data-toc-scroll tabindex="0" role="group" aria-label="目次の縦スクロール">
        <TocList headings={headings} />
      </div>
    </nav>
  ) : variant === "mobile" ? (
    <details data-toc data-toc-variant="mobile" class="rm-mobile-toc not-prose">
      <summary class="toc-mobile-toggle" aria-label="目次を開閉">
        <svg aria-hidden="true" viewBox="0 0 30 30" width="30" height="30">
          <path d="m5 10 10 10 10-10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
        </svg>
      </summary>
      <nav aria-label="目次" class="toc-mobile-panel">
        <h2 class="toc-sidebar-title">目次</h2>
        <div class="toc toc-scrollable toc-sidebar-scroll" data-toc-scroll tabindex="0" role="group" aria-label="目次の縦スクロール">
          <TocList headings={headings} />
        </div>
      </nav>
    </details>
  ) : (
    <details
      data-toc
      data-toc-variant="header"
      class="toc-header not-prose"
    >
      <summary class="toc-toggle">
        <span>目次</span>
        <svg class="toc-chevron" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </summary>
      <div class="toc-header-row">
        <button class="toc-scroll-arrow" data-toc-direction="-1" type="button" aria-label="目次を左へスクロール" aria-controls="toc-header-scroll" disabled>
          <svg aria-hidden="true" viewBox="0 0 0.8660254 1"><polygon points="0,0.5 0.8660254,0 0.8660254,1" fill="currentColor" /></svg>
        </button>
        <nav
          id="toc-header-scroll"
          aria-label="目次"
          class="toc toc-scrollable toc-header-scroll"
          data-toc-scroll
          tabindex="0"
        >
          <TocList headings={headings} />
        </nav>
        <button class="toc-scroll-arrow" data-toc-direction="1" type="button" aria-label="目次を右へスクロール" aria-controls="toc-header-scroll" disabled>
          <svg aria-hidden="true" viewBox="0 0 0.8660254 1"><polygon points="0.8660254,0.5 0,0 0,1" fill="currentColor" /></svg>
        </button>
      </div>
    </details>
  ))
}

<script>
  const TOC_SCROLL_DURATION = 180;

  // 最初に最も速く、目的地に近づくにつれて減速する。
  const easeOutCubic = (progress: number) =>
    1 - Math.pow(1 - progress, 3);

  const initializeToc = () => {
    document.querySelectorAll<HTMLElement>("[data-toc]").forEach((nav) => {
      if (nav.dataset.ready === "true") return;
      nav.dataset.ready = "true";
      let scrollAnimationFrame = 0;
      const controller = new AbortController();
      const { signal } = controller;
      const summary = nav.querySelector<HTMLElement>("summary");
      const disclosure = nav instanceof HTMLDetailsElement ? nav : null;
      const isHorizontal = () => nav.dataset.tocVariant === "header"
        && document.documentElement.classList.contains("rm-active");
      let readingOpen = false;
      const syncReadingDisclosure = () => {
        if (!disclosure) return;
        if (isHorizontal()) {
          readingOpen = true;
          disclosure.open = true;
        } else if (readingOpen) {
          readingOpen = false;
          disclosure.open = false;
        }
      };
      const close = () => { if (disclosure && !isHorizontal()) disclosure.open = false; };

      const items = Array.from(
        nav.querySelectorAll<HTMLLIElement>("[data-toc-id]"),
      );
      const scrollContainer =
        nav.querySelector<HTMLElement>("[data-toc-scroll]");
      const arrows = Array.from(nav.querySelectorAll<HTMLButtonElement>("[data-toc-direction]"));
      const syncArrows = () => {
        if (!scrollContainer) return;
        const maximum = scrollContainer.scrollWidth - scrollContainer.clientWidth;
        arrows.forEach((button) => {
          button.disabled = !isHorizontal() || maximum <= 1
            || (button.dataset.tocDirection === "-1"
              ? scrollContainer.scrollLeft <= 1 : scrollContainer.scrollLeft >= maximum - 1);
        });
      };
      let repeatDelay = 0;
      let repeatTimer = 0;
      let repeatedButton: HTMLButtonElement | undefined;
      const stopRepeat = () => {
        window.clearTimeout(repeatDelay);
        window.clearInterval(repeatTimer);
      };
      arrows.forEach((button) => {
        const move = (continuous = false) => {
          if (!scrollContainer || button.disabled || !isHorizontal()) { stopRepeat(); return; }
          scrollContainer.scrollBy({ left: Number(button.dataset.tocDirection) * (continuous ? 24 : 100),
            behavior: continuous || matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
        };
        // Use click for ordinary activation regardless of the input device.
        // Only a completed hold consumes its following pointer-generated click.
        button.addEventListener("click", (event) => {
          const repeated = event.detail > 0 && repeatedButton === button;
          repeatedButton = undefined;
          stopRepeat();
          if (!repeated) move();
        }, { signal });
        button.addEventListener("pointerdown", (event) => {
          if (event.button !== 0) return;
          stopRepeat();
          repeatedButton = undefined;
          repeatDelay = window.setTimeout(() => {
            repeatedButton = button;
            move(true);
            repeatTimer = window.setInterval(() => move(true), 40);
          }, 300);
        }, { signal });
        button.addEventListener("pointerleave", stopRepeat, { signal });
        button.addEventListener("lostpointercapture", stopRepeat, { signal });
      });
      window.addEventListener("pointerup", stopRepeat, { signal });
      window.addEventListener("pointercancel", stopRepeat, { signal });
      window.addEventListener("blur", stopRepeat, { signal });
      scrollContainer?.addEventListener("scroll", syncArrows, { passive: true, signal });
      let active = "";
      let activeItem: HTMLLIElement | undefined;

      const revealActive = () => {
        if ((disclosure && !disclosure.open) || !activeItem || !scrollContainer?.clientHeight) return;
        const horizontal = isHorizontal();
        const containerRect = scrollContainer.getBoundingClientRect();
        const itemRect = activeItem.getBoundingClientRect();
        const margin = 12;
        const start = horizontal ? "left" : "top";
        const end = horizontal ? "right" : "bottom";
        const size = horizontal ? "width" : "height";
        const extent = horizontal ? scrollContainer.clientWidth : scrollContainer.clientHeight;
        let delta = 0;
        if (itemRect[start] < containerRect[start] + margin
          || itemRect[size] > extent - 2 * margin) {
          delta = itemRect[start] - containerRect[start] - margin;
        } else if (itemRect[end] > containerRect[end] - margin) {
          delta = itemRect[end] - containerRect[end] + margin;
        }
        if (Math.abs(delta) > 1) {
          scrollContainer.scrollBy({
            [start]: delta,
            behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          });
        }
      };

      const activate = (id: string) => {
        if (!id || id === active) return;
        activeItem = undefined;
        items.forEach((item) => {
          const isActive = item.dataset.tocId === id;
          item.classList.toggle("is-active-li", isActive);
          const link = item.querySelector("a");
          if (isActive) link?.setAttribute("aria-current", "location");
          else link?.removeAttribute("aria-current");
          if (isActive) activeItem = item;
        });
        active = id;

        revealActive();
      };

      const headings = items
        .map((item) => document.getElementById(item.dataset.tocId ?? ""))
        .filter((heading): heading is HTMLElement => heading !== null);

      const activeOffset = () => headings[0]
        ? (Number.parseFloat(getComputedStyle(headings[0]).scrollMarginTop) || 64) + 1
        : 64;

      const syncActiveToScrollPosition = () => {
        if (document.documentElement.classList.contains("rm-active")) return;
        const offset = activeOffset();
        const current =
          [...headings]
            .reverse()
            .find(
              (heading) =>
                heading.getBoundingClientRect().top <=
                offset,
            ) ??
          headings[0];
        if (current) activate(current.id);
      };

      syncActiveToScrollPosition();

      const observer = new IntersectionObserver(
        syncActiveToScrollPosition,
        {
          rootMargin: `-${activeOffset()}px 0px -70% 0px`,
        },
      );
      headings.forEach((heading) => observer.observe(heading));

      const resizeObserver = new ResizeObserver(() => { revealActive(); syncArrows(); });
      if (scrollContainer) resizeObserver.observe(scrollContainer);
      const list = nav.querySelector(".toc-list");
      if (list) resizeObserver.observe(list);

      nav.addEventListener("toggle", () => {
        if (disclosure?.open) revealActive();
      }, { signal });
      document.addEventListener("click", (event) => {
        if (disclosure?.open && event.target instanceof Node && !nav.contains(event.target)) {
          close();
        }
      }, { capture: true, signal });
      document.addEventListener("keydown", (event) => {
        if (isHorizontal() || event.key !== "Escape" || !disclosure?.open) return;
        event.preventDefault();
        close();
        summary?.focus({ preventScroll: true });
      }, { signal });
      nav.addEventListener("focusout", (event) => {
        // activeElement can temporarily be body between focusout and focusin.
        // Use the destination so a click from the summary to a link stays open.
        if (event.relatedTarget instanceof Node && !nav.contains(event.relatedTarget)) {
          close();
        }
      }, { signal });

      // Pure vertical wheel input can browse the horizontal row too. Preserve
      // native horizontal gestures, Shift+wheel, and browser zoom gestures.
      scrollContainer?.addEventListener("wheel", (event) => {
        if (!isHorizontal()) return;
        if (event.deltaX !== 0 || event.ctrlKey || event.metaKey || event.shiftKey) return;
        const scale = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? scrollContainer.clientWidth : 1;
        const delta = event.deltaY * scale;
        const canMove = delta < 0 ? scrollContainer.scrollLeft > 0
          : scrollContainer.scrollLeft + scrollContainer.clientWidth < scrollContainer.scrollWidth - 1;
        if (!delta || !canMove) return;
        event.preventDefault();
        scrollContainer.scrollBy({ left: delta, behavior: "instant" });
      }, { passive: false });

      const readingHeading = (event: Event) => {
        syncReadingDisclosure();
        activate((event as CustomEvent<{ id: string }>).detail.id);
        syncArrows();
      };
      const readingOff = () => {
        syncReadingDisclosure();
        syncActiveToScrollPosition();
        stopRepeat();
        syncArrows();
      };
      document.addEventListener("rm:heading", readingHeading);
      document.addEventListener("rm:off", readingOff);

      document.addEventListener(
        "astro:before-swap",
        () => {
          observer.disconnect();
          resizeObserver.disconnect();
          controller.abort();
          stopRepeat();
          window.cancelAnimationFrame(scrollAnimationFrame);
          document.removeEventListener("rm:heading", readingHeading);
          document.removeEventListener("rm:off", readingOff);
        },
        { once: true },
      );

      const scrollToHeading = (heading: HTMLElement) => {
        window.cancelAnimationFrame(scrollAnimationFrame);

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
          heading.scrollIntoView({ behavior: "auto", block: "start" });
          syncActiveToScrollPosition();
          return Promise.resolve();
        }

        return new Promise<void>((resolve) => {
          const startY = window.scrollY;
          const scrollMarginTop =
            Number.parseFloat(getComputedStyle(heading).scrollMarginTop) || 0;
          const maximumY =
            document.documentElement.scrollHeight - window.innerHeight;
          const targetY = Math.min(
            Math.max(
              0,
              startY + heading.getBoundingClientRect().top - scrollMarginTop,
            ),
            maximumY,
          );
          const distance = targetY - startY;
          const startTime = performance.now();

          const scroll = (time: number) => {
            const progress = Math.min(
              (time - startTime) / TOC_SCROLL_DURATION,
              1,
            );
            window.scrollTo({
              top: startY + distance * easeOutCubic(progress),
              behavior: "auto",
            });
            // 高速スクロールでは IntersectionObserver の判定帯を見出しが
            // 飛び越えることがあるため、各フレームの現在位置から同期する。
            syncActiveToScrollPosition();
            if (progress < 1) {
              scrollAnimationFrame = window.requestAnimationFrame(scroll);
            } else {
              resolve();
            }
          };

          scrollAnimationFrame = window.requestAnimationFrame(scroll);
        });
      };

      const focusHeading = (heading: HTMLElement) => {
        const hadTabIndex = heading.hasAttribute("tabindex");
        if (!hadTabIndex) heading.tabIndex = -1;
        heading.focus({ preventScroll: true });
        if (!hadTabIndex) {
          heading.addEventListener(
            "blur",
            () => heading.removeAttribute("tabindex"),
            { once: true },
          );
        }
      };

      nav.querySelectorAll<HTMLAnchorElement>("a.toc-link").forEach((link) => {
        link.addEventListener("click", async (event) => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const id = decodeURIComponent(link.hash.slice(1));
          const heading = document.getElementById(id);
          if (!heading) return;
          event.preventDefault();
          close();
          // Reading mode handles the native plane during capture. Its header
          // stays visible; only single-column reading uses a disclosure.
          if (document.documentElement.classList.contains("rm-active")) return;
          await scrollToHeading(heading);
          history.replaceState(history.state, "", `#${encodeURIComponent(id)}`);
          activate(id);
          focusHeading(heading);
        });
      });
    });
  };

  document.addEventListener("astro:page-load", initializeToc);
</script>
